---
// Sticky header. Desktop: inline links with an "Apps" dropdown that lists all
// nine apps (shows on hover and on keyboard focus). Mobile: a <details> panel
// behind a hamburger, pure HTML/CSS, no JS.
const apps = [
    { name: 'Escalator Field Command', tag: 'Tools for escalator mechanics', href: '/escalator-field-command/', icon: '/images/escalator-field-command-icon.webp' },
    { name: 'HealthTrail Medical', tag: 'Your complete health timeline', href: '/healthtrail-medical/', icon: '/images/healthtrail-medical-icon.webp' },
    { name: 'Clock-In Everyday', tag: 'Daily coached workouts', href: '/clock-in-everyday/', icon: '/images/clock-in-everyday-icon.webp' },
    { name: 'RidgePacker', tag: 'Hiking and backpacking gear', href: '/ridgepacker/', icon: '/images/ridgepacker-icon.webp' },
    { name: 'SnapLedger', tag: 'Bills and subscriptions', href: '/snapledger/', icon: '/images/snapledger-icon.webp' },
    { name: 'Gold Watcher', tag: 'Gold price tracker', href: '/gold-watcher/', icon: '/images/gold-watcher-icon.webp' },
    { name: 'Silver Watcher', tag: 'Silver price tracker', href: '/silver-watcher/', icon: '/images/silver-watcher-icon.webp' },
    { name: 'Copper Watcher', tag: 'Copper price tracker', href: '/copper-watcher/', icon: '/images/copper-watcher-icon.webp' },
    { name: 'Lithium Watcher', tag: 'Lithium and EV markets', href: '/lithium-watcher/', icon: '/images/lithium-watcher-icon.webp' }
];
---

<header class="site-nav">
    <div class="wrap nav-in">
        <a class="brand" href="/">
            <picture>
                <source srcset="/images/hero-ai-handshake-transparent.webp" type="image/webp" />
                <img src="/images/hero-ai-handshake-transparent.png" alt="" width="37" height="28" />
            </picture>
            <span>Artificial Igknorance</span>
        </a>

        <nav class="links" aria-label="Main">
            <div class="has-menu">
                <button type="button" class="menu-btn" aria-haspopup="true">
                    Apps
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 9 7 7 7-7" /></svg>
                </button>
                <div class="menu-panel">
                    <div class="menu-grid">
                        {apps.map((a) => (
                            <a href={a.href} class="menu-item">
                                <img src={a.icon} alt="" width="36" height="36" loading="lazy" />
                                <span><b>{a.name}</b><i>{a.tag}</i></span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
            <a href="/#privacy">Privacy</a>
            <a href="/about/">About</a>
            <a href="/#faq">FAQ</a>
            <a href="/#contact">Contact</a>
            <a class="ext" href="https://counterweightdispatch.com" target="_blank" rel="noopener noreferrer">Counterweight Dispatch &#8599;</a>
        </nav>

        <details class="mobile">
            <summary aria-label="Open menu">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
            </summary>
            <div class="panel">
                <a href="/">Home</a>
                <div class="group">Apps</div>
                {apps.map((a) => (
                    <a href={a.href} class="app-row"><img src={a.icon} alt="" width="28" height="28" loading="lazy" />{a.name}</a>
                ))}
                <div class="group">Site</div>
                <a href="/#privacy">Privacy</a>
                <a href="/about/">About</a>
                <a href="/#faq">FAQ</a>
                <a href="/#contact">Contact</a>
                <a href="https://counterweightdispatch.com" target="_blank" rel="noopener noreferrer">Counterweight Dispatch &#8599;</a>
            </div>
        </details>
    </div>
</header>

<style>
    .site-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(251, 251, 253, 0.78);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid var(--color-line);
    }
    .nav-in {
        position: relative;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 650;
        letter-spacing: -0.02em;
        font-size: 17px;
        color: var(--color-ink);
    }
    .brand img {
        height: 28px;
        width: auto;
        display: block;
    }
    .links {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 14px;
    }
    .links a,
    .menu-btn {
        text-decoration: none;
        color: #3a3a3e;
        transition: color 0.15s;
    }
    .links a:hover,
    .menu-btn:hover,
    .has-menu:focus-within .menu-btn {
        color: var(--color-accent);
    }
    .links .ext {
        color: var(--color-muted);
    }
    .menu-btn {
        background: none;
        border: 0;
        padding: 20px 0;
        font: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .menu-panel {
        position: absolute;
        right: 0;
        top: 100%;
        padding-top: 4px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    }
    .has-menu:hover .menu-panel,
    .has-menu:focus-within .menu-panel {
        opacity: 1;
        visibility: visible;
        transform: none;
    }
    .menu-grid {
        width: min(620px, calc(100vw - 48px));
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        padding: 10px;
        background: #fff;
        border: 1px solid var(--color-line);
        border-radius: 22px;
        box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.25);
    }
    .menu-item {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 10px 12px;
        border-radius: 14px;
    }
    .menu-item:hover {
        background: var(--color-tint);
    }
    .menu-item img {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        flex: none;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    }
    .menu-item b {
        display: block;
        font-size: 14px;
        font-weight: 620;
        color: var(--color-ink);
        line-height: 1.25;
    }
    .menu-item i {
        display: block;
        font-style: normal;
        font-size: 12.5px;
        color: var(--color-muted);
        line-height: 1.3;
    }

    .mobile {
        display: none;
        position: relative;
    }
    .mobile summary {
        list-style: none;
        cursor: pointer;
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        color: var(--color-ink);
    }
    .mobile summary::-webkit-details-marker {
        display: none;
    }
    .mobile summary:hover {
        background: rgba(0, 0, 0, 0.05);
    }
    .mobile .panel {
        position: absolute;
        right: 0;
        top: 52px;
        width: min(300px, calc(100vw - 32px));
        max-height: calc(100vh - 90px);
        overflow-y: auto;
        background: #fff;
        border: 1px solid var(--color-line);
        border-radius: 20px;
        box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.25);
        padding: 8px;
    }
    .mobile .panel a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 500;
        color: var(--color-ink);
    }
    .mobile .panel a:hover {
        background: var(--color-tint);
    }
    .mobile .panel .app-row img {
        width: 28px;
        height: 28px;
        border-radius: 7px;
    }
    .mobile .group {
        padding: 12px 14px 4px;
        font-size: 11.5px;
        font-weight: 650;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
    }
    @media (max-width: 900px) {
        .links {
            display: none;
        }
        .mobile {
            display: block;
        }
    }
</style>
