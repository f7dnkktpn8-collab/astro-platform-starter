---
// Footer with internal cross-links so every page (especially on mobile, where
// the header nav lives behind a hamburger) has reachable navigation back to
// the apps, the projects, the about page, and legal. Also a small SEO win:
// every page links back to the priority pages.
---

<footer class="site-footer">
    <div class="wrap">
        <div class="fgrid">
            <div class="about">
                <a class="brand" href="/">
                    <picture>
                        <source srcset="/images/hero-ai-handshake-transparent.webp" type="image/webp" />
                        <img src="/images/hero-ai-handshake-transparent.png" alt="" width="37" height="28" loading="lazy" />
                    </picture>
                    <span>Artificial Igknorance</span>
                </a>
                <p>Privacy-first iPhone apps for work, health, money and the outdoors.</p>
            </div>
            <div>
                <h4>Apps</h4>
                <ul>
                    <li><a href="/escalator-field-command/">Escalator Field Command</a></li>
                    <li><a href="/healthtrail-medical/">HealthTrail Medical</a></li>
                    <li><a href="/clock-in-everyday/">Clock-In Everyday</a></li>
                    <li><a href="/ridgepacker/">RidgePacker</a></li>
                    <li><a href="/snapledger/">SnapLedger</a></li>
                </ul>
            </div>
            <div>
                <h4>Watchers</h4>
                <ul>
                    <li><a href="/gold-watcher/">Gold Watcher</a></li>
                    <li><a href="/silver-watcher/">Silver Watcher</a></li>
                    <li><a href="/copper-watcher/">Copper Watcher</a></li>
                    <li><a href="/lithium-watcher/">Lithium Watcher</a></li>
                </ul>
            </div>
            <div>
                <h4>Site</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/about/">About</a></li>
                    <li><a href="/#faq">FAQ</a></li>
                    <li><a href="/#contact">Contact</a></li>
                    <li>
                        <a href="https://counterweightdispatch.com" target="_blank" rel="noopener noreferrer">Counterweight Dispatch</a>
                    </li>
                    <li><a href="/privacy/">Privacy</a></li>
                    <li><a href="/terms/">Terms</a></li>
                </ul>
            </div>
        </div>
        <div class="legal">
            <span>&copy; {new Date().getFullYear()} Artificial Igknorance. All rights reserved.</span>
            <span>The apps have no accounts, no ads and no tracking.</span>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: clamp(56px, 8vw, 96px);
        border-top: 1px solid var(--color-line);
        padding: 48px 0 56px;
        font-size: 14px;
        color: var(--color-muted);
    }
    .fgrid {
        display: grid;
        grid-template-columns: 1.4fr repeat(3, 1fr);
        gap: 32px;
    }
    @media (max-width: 820px) {
        .fgrid {
            grid-template-columns: 1fr 1fr;
        }
        .fgrid .about {
            grid-column: 1 / -1;
        }
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 650;
        letter-spacing: -0.02em;
        font-size: 17px;
        color: var(--color-ink);
    }
    .brand img {
        height: 28px;
        width: auto;
        display: block;
    }
    .about p {
        max-width: 26em;
        line-height: 1.55;
        margin-top: 12px;
    }
    h4 {
        margin: 0 0 12px;
        font-size: 13px;
        color: var(--color-ink);
        font-weight: 650;
        letter-spacing: 0.01em;
    }
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 9px;
    }
    li a {
        text-decoration: none;
        color: var(--color-muted);
        transition: color 0.15s;
    }
    li a:hover {
        color: var(--color-accent);
    }
    .legal {
        margin-top: 40px;
        padding-top: 22px;
        border-top: 1px solid var(--color-line);
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }
</style>
