---
import Layout from '../layouts/Layout.astro';
import Shot from '../components/Shot.astro';
import '../styles/home.css';

// Cross-app FAQs covering the brand-level questions visitors most often have:
// privacy, why no signup, pricing, platform reach. Same content powers the
// visible accordion AND a FAQPage JSON-LD block for Google rich results / AI
// Overviews. Keep the answers tight: they're rendered verbatim in search.
const faqs = [
    {
        q: "Why don't your apps ask me to create an account?",
        a: "Because the apps don't need your data to work. Everything lives on your iPhone, so there's nothing on our side to leak and nothing for you to remember. You open the app and start using it."
    },
    {
        q: 'Is my data really private?',
        a: 'Yes. There are no analytics SDKs, no third-party trackers, no cloud sync and no telemetry. Backing up or exporting is something you trigger yourself, and it goes only where you send it. The two AI features described in the privacy section are the only exceptions.'
    },
    {
        q: 'Are the apps available outside the United States?',
        a: 'Yes, in most countries. The Watcher apps support 10 or more currencies with live prices. Everything is built for iPhone, and Escalator Field Command and RidgePacker run on iPad too.'
    },
    {
        q: 'What does "Artificial Igknorance" mean?',
        a: 'It\'s a play on "artificial intelligence", and the misspelling is deliberate. Our apps don\'t need to know who you are to be useful, so we leaned into being ignorant on purpose.'
    }
];

const faqStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a }
    }))
};

// VideoObject schema for the Escalator Field Command demo video. Makes the
// video eligible for Google's video rich results (thumbnail + play icon next
// to the search listing). The thumbnail uses the dashboard screenshot since
// it represents what the video opens on.
const SITE_URL = 'https://artificialigknorance.com';
const videoStructuredData = {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    '@id': SITE_URL + '/#escalator-demo-video',
    name: 'Escalator Field Command: quick app demo',
    description:
        'A short walk-through of Escalator Field Command on iPhone: the daily command-center dashboard, Cat 1 testing progress, SSPI compliance logs, and per-unit shutdown records, built for working escalator mechanics.',
    thumbnailUrl: [SITE_URL + '/images/screenshots/escalator/dashboard-overview.jpg'],
    uploadDate: '2026-04-29T00:00:00+00:00',
    duration: 'PT10S',
    contentUrl: SITE_URL + '/videos/escalator-field-command-demo.mp4',
    embedUrl: SITE_URL + '/#escalator-field-command',
    publisher: { '@id': SITE_URL + '/#organization' },
    about: { '@id': SITE_URL + '/#escalator-field-command' },
    inLanguage: 'en-US'
};

// Each shot is [file name in /images/home/, alt text, width, height].
const everyday = [
    {
        id: 'healthtrail-medical',
        name: 'HealthTrail Medical',
        tag: 'Your complete health timeline',
        page: '/healthtrail-medical/',
        store: 'https://apps.apple.com/us/app/healthtrail-medical/id6758072258',
        icon: 'healthtrail-medical',
        tint: 'health',
        kind: 'poster',
        shots: [
            ['health-timeline', 'HealthTrail Medical timeline screen', 370, 800],
            ['health-meds', 'HealthTrail Medical medications screen', 370, 800]
        ],
        desc: 'A medical memory for the whole family. Every appointment, medication and vaccine on one visual timeline, with optional photo scanning that fills in the details for you.'
    },
    {
        id: 'clock-in-everyday',
        name: 'Clock-In Everyday',
        tag: 'Your new full time job is your body',
        page: '/clock-in-everyday/',
        store: 'https://apps.apple.com/us/app/clock-in-everyday/id6791800212',
        icon: 'clock-in-everyday',
        tint: 'clock',
        kind: 'phone',
        shots: [
            ['clock-dashboard', 'Clock-In Everyday dashboard', 640, 1390],
            ['clock-workout', 'Clock-In Everyday workout screen', 640, 1390]
        ],
        desc: 'Daily coached workouts for people over 50. A morning readiness score from Apple Health shapes a session around how you actually slept and recovered.'
    },
    {
        id: 'ridgepacker',
        name: 'RidgePacker',
        tag: 'Hiking and backpacking gear',
        page: '/ridgepacker/',
        store: 'https://apps.apple.com/us/app/ridgepacker/id6766699306',
        icon: 'ridgepacker',
        tint: 'ridge',
        kind: 'poster',
        shots: [
            ['ridge-trips', 'RidgePacker trips screen', 640, 1390],
            ['ridge-catalog', 'RidgePacker gear catalog screen', 640, 1390]
        ],
        desc: 'Catalog every piece of gear with a photo and a weight, then build a packing list for any trip. Track your packed weight and keep a permanent Everyday Carry list. iPhone and iPad.'
    },
    {
        id: 'snapledger',
        name: 'SnapLedger ø',
        tag: 'Bills and subscriptions tracker',
        page: '/snapledger/',
        store: 'https://apps.apple.com/ca/app/snapledger-%C3%B8/id6759497982',
        icon: 'snapledger',
        tint: 'snap',
        kind: 'poster',
        shots: [
            ['snap-overview', 'SnapLedger household bills screen', 368, 800],
            ['snap-subs', 'SnapLedger subscriptions screen', 368, 800]
        ],
        desc: 'Take a photo of a bill and the details fill themselves in. Sort subscriptions by category and watch the household total move month to month. No bank login anywhere.'
    }
];

const watchers = [
    {
        id: 'gold-watcher',
        name: 'Gold Watcher',
        tag: 'Au · Gold is the new Gold',
        page: '/gold-watcher/',
        store: 'https://apps.apple.com/us/app/gold-watcher-au/id6758283387',
        icon: 'gold-watcher',
        tint: 'gold',
        shot: ['gold-spot', 'Gold Watcher spot price screen'],
        desc: 'Live spot price, GLD, IAU and SGOL, the gold/silver ratio and a karat calculator.'
    },
    {
        id: 'silver-watcher',
        name: 'Silver Watcher',
        tag: 'Ag · Price tracker and alerts',
        page: '/silver-watcher/',
        store: 'https://apps.apple.com/us/app/silver-watcher-ag/id6760270695',
        icon: 'silver-watcher',
        tint: 'silver',
        shot: ['silver-spot', 'Silver Watcher spot price screen'],
        desc: 'Spot price, SLV, SIVR and PSLV, ratio signals and a purity calculator in 12 currencies.'
    },
    {
        id: 'copper-watcher',
        name: 'Copper Watcher',
        tag: 'Cu · Copper is the future',
        page: '/copper-watcher/',
        store: 'https://apps.apple.com/us/app/copper-watcher-cu/id6757655923',
        icon: 'copper-watcher',
        tint: 'copper',
        shot: ['copper-signals', 'Copper Watcher signals screen'],
        desc: 'Spot price, CPER, COPX and COPP, the Dr Copper signal and a scrap calculator in 10 currencies.'
    },
    {
        id: 'lithium-watcher',
        name: 'Lithium Watcher',
        tag: 'Li · From mine to the road',
        page: '/lithium-watcher/',
        store: 'https://apps.apple.com/us/app/lithium-watcher-li/id6761344726',
        icon: 'lithium-watcher',
        tint: 'lithium',
        shot: ['lithium-markets', 'Lithium Watcher markets screen'],
        desc: 'Lithium prices from three sources, mining stocks and the big EV makers on one compare chart.'
    }
];
---

<Layout
    title="Escalator Field Command: iOS App for Escalator Mechanics | Artificial Igknorance"
    description="Escalator Field Command is an iOS app for escalator mechanics: routes, Category 1 testing, SSPI compliance, inspections. Plus privacy-first apps for health, finance and more by Artificial Igknorance."
    ogTitle="Artificial Igknorance | Privacy-first iOS apps"
    ogDescription="Privacy-first iOS apps. No accounts, no cloud, no tracking: everything stays on your iPhone. Tools for health, finance, hiking, and the escalator industry."
    contained={false}
>
    <link slot="head" rel="preload" as="image" href="/images/home/efc-dashboard.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqStructuredData)} />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(videoStructuredData)} />

    <div class="home">
        <!-- Hero -->
        <section class="hero">
            <div class="wrap">
                <span class="eyebrow"><i></i>Nine apps on the App Store</span>
                <h1>Apps that mind their own business.</h1>
                <p class="sub">No sign-up, no account, no ads. What you put in lives on your iPhone and stays there.</p>
                <div class="cta">
                    <a class="hbtn" href="#apps">Browse the apps</a>
                    <a class="link" href="#privacy">How we treat your data &#8250;</a>
                </div>
            </div>
            <div class="stage" aria-hidden="true">
                <div class="phone p-side p-left"><Shot name="clock-dashboard" width={640} height={1390} eager /></div>
                <div class="phone p-main"><Shot name="efc-dashboard" width={640} height={1391} eager /></div>
                <div class="phone p-side p-right"><Shot name="efc-cat1" width={368} height={800} eager /></div>
            </div>
            <div class="wrap">
                <div class="stats">
                    <div class="stat"><b>0</b><span>accounts to create</span></div>
                    <div class="stat"><b>0</b><span>trackers inside</span></div>
                    <div class="stat"><b>0</b><span>ads in any app</span></div>
                    <div class="stat"><b>9</b><span>apps, all free to download</span></div>
                </div>
            </div>
        </section>

        <!-- Apps -->
        <section class="sec" id="apps">
            <div class="wrap">
                <div class="sec-head">
                    <h2>Built for the work, not for the data.</h2>
                    <p>Every app is free to download. Pro upgrades are optional and always start with a free trial.</p>
                </div>

                <div id="industry">
                    <article class="feature" id="escalator-field-command">
                        <div class="feature-copy">
                            <span class="kicker">Featured &middot; Escalator industry</span>
                            <div class="feature-id">
                                <img src="/images/escalator-field-command-icon.webp" alt="" width="68" height="68" />
                                <div><h3 class="feature-title">Escalator Field Command</h3></div>
                            </div>
                            <p class="lead">
                                Maintenance routes, Category 1 testing, SSPI compliance and inspection logs in one app. A searchable Field Guide to the safety codes comes with it.
                            </p>
                            <ul class="checks">
                                {
                                    [
                                        'Category 1 test progress, building by building',
                                        'SSPI brake and step-skirt test records',
                                        'Unit shutdown logs with the reason on file',
                                        'Works on iPhone and iPad'
                                    ].map((item) => (
                                        <li>
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" opacity=".35" /><path d="m8 12.5 2.8 2.8L16 9.5" /></svg>
                                            {item}
                                        </li>
                                    ))
                                }
                            </ul>
                            <div class="feature-actions">
                                <a class="badge" href="https://apps.apple.com/us/app/escalator-field-command/id6756789866" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" /></a>
                                <button type="button" class="ghost" data-open-escalator-video>Watch the 10-second demo &#9654;</button>
                                <a class="ghost" href="/escalator-field-command/">Learn more &#8250;</a>
                            </div>
                        </div>
                        <div class="feature-media" aria-hidden="true">
                            <div class="phone f1"><Shot name="efc-sspi" width={368} height={800} /></div>
                            <div class="phone f2"><Shot name="efc-shutdown" width={368} height={800} /></div>
                        </div>
                    </article>
                </div>

                <div class="subhead" id="health"><h3>For everyday life</h3><p>Your health, your family, your gear and your bills.</p></div>
                <div class="grid2" style="margin-top:22px">
                    {
                        everyday.map((a) => (
                            <article class="tile" id={a.id}>
                                <div class={`media tint-${a.tint}`}>
                                    {a.kind === 'poster'
                                        ? a.shots.map((s, i) => <Shot name={s[0] as string} alt={s[1] as string} width={s[2] as number} height={s[3] as number} class={`poster ${i === 0 ? 'a' : 'b'}`} />)
                                        : a.shots.map((s, i) => (
                                              <div class={`phone ${i === 0 ? 'a' : 'b'}`}>
                                                  <Shot name={s[0] as string} alt={s[1] as string} width={s[2] as number} height={s[3] as number} />
                                              </div>
                                          ))}
                                </div>
                                <div class="tile-body">
                                    <div class="id">
                                        <img src={`/images/${a.icon}-icon.webp`} alt="" width="52" height="52" loading="lazy" />
                                        <div><h4>{a.name}</h4><div class="tag">{a.tag}</div></div>
                                    </div>
                                    <p class="desc">{a.desc}</p>
                                    <div class="actions">
                                        <a class="badge" href={a.store} target="_blank" rel="noopener noreferrer" aria-label={`Download ${a.name} on the App Store`}><img src="/images/appstore-badge.svg" alt="Download on the App Store" width="120" height="40" loading="lazy" /></a>
                                        <a class="more" href={a.page}>Details &#8250;</a>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <div class="subhead" id="financial"><h3>The Watchers</h3><p>Live metal prices, ETFs and portfolios. Gold, silver, copper and lithium.</p></div>
                <div class="grid4 watch" style="margin-top:22px">
                    {
                        watchers.map((a) => (
                            <article class="tile" id={a.id}>
                                <div class={`media short tint-${a.tint}`}>
                                    <Shot name={a.shot[0]} alt={a.shot[1]} width={640} height={1390} class="poster solo" />
                                </div>
                                <div class="tile-body">
                                    <div class="id">
                                        <img src={`/images/${a.icon}-icon.webp`} alt="" width="44" height="44" loading="lazy" />
                                        <div><h4>{a.name}</h4><div class="tag">{a.tag}</div></div>
                                    </div>
                                    <p class="desc">{a.desc}</p>
                                    <div class="actions">
                                        <a class="badge" href={a.store} target="_blank" rel="noopener noreferrer" aria-label={`Download ${a.name} on the App Store`}><img src="/images/appstore-badge.svg" alt="Download on the App Store" width="120" height="40" loading="lazy" /></a>
                                        <a class="more" href={a.page}>Details &#8250;</a>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Privacy -->
        <section class="sec" id="privacy">
            <div class="wrap">
                <div class="privacy">
                    <h2>Your data stays where you put it.</h2>
                    <p class="intro">
                        Most apps treat your information as the product. These ones treat the app as the product, and that one decision shapes everything else about how they work.
                    </p>
                    <div class="pgrid">
                        <div class="pitem">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="4" /><path d="M2.5 20c.6-3.6 3.6-5.5 7.5-5.5 1.6 0 3 .3 4.2.9M17 15l5 5M22 15l-5 5" /></svg>
                            <h3>No accounts</h3><p>Open the app and start. No email to confirm, no password to forget.</p>
                        </div>
                        <div class="pitem">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 6.1A10.8 10.8 0 0 1 12 6c5.5 0 9 6 9 6a15 15 0 0 1-3.2 3.8M6.5 7.6C4 9.3 3 12 3 12s3.5 6 9 6c1.3 0 2.5-.3 3.6-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                            <h3>No tracking</h3><p>No analytics SDKs, no third-party trackers, nothing phoning home.</p>
                        </div>
                        <div class="pitem">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 8.5a4 4 0 0 1-.5 9.5H7Z" /><path d="M4 4l16 16" /></svg>
                            <h3>No cloud sync</h3><p>Your records are stored on your iPhone. Exporting is something you choose to do.</p>
                        </div>
                        <div class="pitem">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            <h3>Nothing to sell</h3><p>Your data isn't the product, so there is nothing to sell.</p>
                        </div>
                    </div>
                    <div class="fine">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z" /><path d="M12 10v5M12 18v.01" /></svg>
                        <p>
                            <b>Two exceptions, stated plainly.</b> The AI coach in Clock-In Everyday sends your readiness, goals and notes to a secure server so it can write today's session. Nothing is kept afterward and nothing is tied to an account. Optional medication scanning in HealthTrail Medical sends the photo you chose to an AI provider to read it, and it is not stored by them for training. The full detail is in the <a href="/privacy/">Privacy Policy</a>.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Maker + Counterweight Dispatch -->
        <section class="sec" id="maker">
            <div class="wrap maker">
                <div class="card">
                    <div class="brandline">
                        <picture>
                            <source srcset="/images/hero-ai-handshake-transparent.webp" type="image/webp" />
                            <img src="/images/hero-ai-handshake-transparent.png" alt="" width="45" height="34" loading="lazy" />
                        </picture>
                        Artificial Igknorance
                    </div>
                    <h2>About the name.</h2>
                    <p>
                        Artificial Igknorance is a joke on "artificial intelligence". The smartest software isn't the kind that knows everything about you. It's the kind that stays strategically ignorant, and the misspelling is on purpose.
                    </p>
                    <p>
                        Every app follows the same rules: your information stays on your phone, and nobody is waiting to monetize it.
                    </p>
                    <div class="cta" style="justify-content:flex-start"><a class="link" href="/about/">More about the apps and the name &#8250;</a></div>
                </div>
                <div class="card">
                    <h2>Also in the works</h2>
                    <p>Counterweight Dispatch is a home for people in the vertical transportation trade. It's also where the Field Guides live.</p>
                    <a class="sitelink" href="https://counterweightdispatch.com" target="_blank" rel="noopener noreferrer">
                        <picture>
                            <source srcset="/images/counterweight-dispatch-icon.webp" type="image/webp" />
                            <img src="/images/counterweight-dispatch-icon.png" alt="" width="38" height="36" loading="lazy" />
                        </picture>
                        counterweightdispatch.com &#8599;
                    </a>
                    <a class="guides" href="https://counterweightdispatch.com/#field-guides" target="_blank" rel="noopener noreferrer" aria-label="The Field Guides on Counterweight Dispatch">
                        <div class="books">
                            <div class="book">
                                <picture>
                                    <source srcset="/images/escalator-field-guide-book-lg.webp" type="image/webp" />
                                    <img src="/images/escalator-field-guide-book-lg.png" alt="Escalator Field Guide book icon" width="240" height="285" loading="lazy" />
                                </picture>
                                <span>Escalator</span>
                            </div>
                            <div class="book mid">
                                <picture>
                                    <source srcset="/images/vertical-transportation-field-guide-book.webp" type="image/webp" />
                                    <img src="/images/vertical-transportation-field-guide-book.png" alt="Vertical Transportation Field Guide book icon" width="240" height="285" loading="lazy" />
                                </picture>
                                <span>Both in one</span>
                            </div>
                            <div class="book">
                                <picture>
                                    <source srcset="/images/elevator-field-guide-book.webp" type="image/webp" />
                                    <img src="/images/elevator-field-guide-book.png" alt="Elevator Field Guide book icon" width="240" height="285" loading="lazy" />
                                </picture>
                                <span>Elevator</span>
                            </div>
                        </div>
                        <div class="guides-text">
                            <b>The Field Guides</b>
                            <span>The code book rewritten in plain English, and searchable the way you'd ask a senior mechanic. Choose the Escalator guide, the Elevator guide, or both in one book. Paid, with a free trial.</span>
                            <em>See the Field Guides &#8250;</em>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="sec" id="faq">
            <div class="wrap">
                <div class="sec-head"><h2>Questions people ask first.</h2></div>
                <div class="max-w-3xl mx-auto space-y-3">
                    {
                        faqs.map(({ q, a }) => (
                            <details class="p-5 transition-all bg-white border border-line rounded-2xl group hover:shadow-md">
                                <summary class="flex items-center justify-between gap-4 text-lg font-semibold cursor-pointer list-none">
                                    <span>{q}</span>
                                    <svg class="flex-shrink-0 w-8 h-8 p-1.5 transition-transform duration-300 rounded-full bg-[#efeff2] text-muted group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </summary>
                                <p class="mt-3 text-body">{a}</p>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section id="contact">
            <div class="wrap">
                <div class="closing">
                    <h2>Find them all on the App Store.</h2>
                    <p>Questions, a bug, or an idea for the next app? Write to <a class="mail" href="mailto:info@artificialigknorance.com">info@artificialigknorance.com</a>, or find @igknorance on X.</p>
                    <div class="row">
                        <a class="badge" href="https://apps.apple.com/us/developer/mike-dangerfield/id1588904052" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store"><img src="/images/appstore-badge.svg" alt="Download on the App Store" /></a>
                        <a class="mail" href="https://x.com/igknorance" target="_blank" rel="noopener noreferrer">@igknorance on X</a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Escalator Video Modal -->
    <div id="escalator-video-modal" class="fixed inset-0 z-50 flex flex-col items-center justify-center hidden bg-black/85 backdrop-blur-sm">
        <button
            id="escalator-modal-close"
            class="fixed top-4 right-4 z-[60] flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white font-semibold px-4 py-2 rounded-full backdrop-blur-sm transition-all duration-200 shadow-lg"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            Close
        </button>
        <div id="escalator-video-container" class="relative w-full max-w-3xl px-4" style="max-height: 90vh;">
            <video
                id="escalator-video"
                class="w-full shadow-2xl rounded-2xl"
                style="max-height: 80vh; object-fit: contain;"
                controls
                playsinline
                preload="metadata"
                poster="/images/screenshots/escalator/dashboard-overview.jpg"
                aria-label="Escalator Field Command quick app demo: a 10-second walk-through of the dashboard, Cat 1 testing, SSPI compliance, and unit shutdowns"
                src="/videos/escalator-field-command-demo.mp4"
            >
            </video>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('escalator-video-modal');
            var video = document.getElementById('escalator-video') as HTMLVideoElement | null;
            var closeBtn = document.getElementById('escalator-modal-close');
            var videoContainer = document.getElementById('escalator-video-container');
            if (!modal || !videoContainer) return;

            function openModal() {
                modal!.classList.remove('hidden');
                // Push a history state so the back button closes the modal
                history.pushState({ escalatorVideoOpen: true }, '');
            }

            function closeModal() {
                modal!.classList.add('hidden');
                if (video) {
                    video.pause();
                    video.currentTime = 0;
                }
            }

            function requestClose() {
                // If we pushed a state, go back to pop it; otherwise just close
                if (history.state && history.state.escalatorVideoOpen) {
                    history.back();
                } else {
                    closeModal();
                }
            }

            document.querySelectorAll('[data-open-escalator-video]').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    openModal();
                });
            });

            if (closeBtn)
                closeBtn.addEventListener('click', function (e) {
                    // Stop the click reaching the backdrop handler below, which would call back() a second time
                    e.stopPropagation();
                    requestClose();
                });

            // Click on the backdrop (but not the video) closes the modal
            modal.addEventListener('click', function (e) {
                if (!videoContainer!.contains(e.target as Node)) requestClose();
            });

            // Browser back button closes the modal
            window.addEventListener('popstate', function () {
                if (!modal!.classList.contains('hidden')) closeModal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') requestClose();
            });
        })();
    </script>
</Layout>
