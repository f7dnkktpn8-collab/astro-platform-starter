---
import Layout from '../../layouts/Layout.astro';
const DEVELOPER = "Artificial Igknorance";
const CONTACT_EMAIL = "info@artificialigknorance.com";
---

<Layout title="Delete Your Account | Family Lists" smartAppId="">
  <div class="max-w-3xl mx-auto py-12 px-4">

    <!-- Back link -->
    <a href="/" class="inline-flex items-center gap-2 text-accent hover:text-accent-deep transition-colors mb-8 text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Home
    </a>

    <h1 class="text-4xl font-bold mb-2 text-ink">
      Delete Your Account
    </h1>
    <p class="text-muted text-sm mb-10">
      Family Lists &middot; {DEVELOPER}
    </p>

    <div class="prose prose-invert prose-lg max-w-none space-y-8">

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Delete your account in the app</h2>
        <p class="text-body leading-relaxed">
          You can permanently delete your Family Lists account, right from your phone, without contacting us:
        </p>
        <ol class="list-decimal list-inside text-body space-y-2 mt-3 ml-4">
          <li>Open Family Lists</li>
          <li>Go to the <strong class="text-ink">Settings</strong> tab</li>
          <li>Scroll to the bottom and tap <strong class="text-ink">Delete account</strong></li>
          <li>Confirm the deletion</li>
        </ol>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">What gets deleted</h2>
        <p class="text-body leading-relaxed">
          Deleting your account permanently removes your account, your wish lists, your private gift ideas,
          and your profile photo. Items you added to a shared grocery list are removed too. This cannot be
          undone.
        </p>
        <p class="text-body leading-relaxed mt-3">
          Deletion takes effect immediately. Nothing is held back or retained after your account is deleted.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Need help?</h2>
        <p class="text-body leading-relaxed">
          If you're unable to access the app to delete your account yourself, contact us and we'll delete it
          for you:
        </p>
        <div class="mt-3 p-4 bg-white rounded-xl border border-line">
          <p class="text-ink font-semibold">{DEVELOPER}</p>
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent hover:text-accent-deep transition-colors">
            {CONTACT_EMAIL}
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>
